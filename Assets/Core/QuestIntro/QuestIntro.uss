:root {
    --bg: rgb(20, 17, 26);
    --panel: rgb(38, 32, 46);
    --panel-hover: rgb(54, 46, 66);
    --gold: rgb(224, 184, 64);
    --gold-dim: rgb(110, 92, 52);
    --text: rgb(240, 232, 215);
    --text-muted: rgb(160, 150, 140);
    --danger: rgb(220, 80, 70);
    --ok: rgb(48, 130, 60);
    --ok-hover: rgb(64, 160, 76);
}

.screen {
    flex-grow: 1;
    background-color: var(--bg);
    padding: 40px 64px 40px 64px;
    align-items: center;
    justify-content: center;
}

/* Conteneur anime par le script (echelle + opacite) */
.content {
    flex-grow: 1;
    align-self: stretch;
    align-items: center;
    justify-content: center;
}

/* ---------- En-tete ---------- */
.header { align-items: center; margin-bottom: 28px; }

.quest-number {
    font-size: 22px;
    color: var(--text-muted);
    letter-spacing: 4px;
}

.quest-title {
    font-size: 58px;
    color: var(--gold);
    -unity-font-style: bold;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- Parchemin ---------- */
.parchment {
    width: 1100px;
    max-width: 100%;
    max-height: 560px;
    flex-shrink: 1;
    padding: 36px 48px 36px 48px;
    background-color: var(--panel);
    border-width: 3px;
    border-color: var(--gold-dim);
    border-radius: 14px;

}

.speaker {
    margin-bottom: 16px;
    padding-bottom: 12px;
    font-size: 40px;
    color: var(--gold);
    -unity-font-style: bold;
    letter-spacing: 6px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.text-scroll { flex-shrink: 1; }

.parchment-text {
    font-size: 30px;
    color: var(--text);
    white-space: normal;
    -unity-font-style: italic;
}

/* ---------- Pied de page ---------- */
.footer {
    margin-top: 36px;
    align-items: center;
}

.validate-button {
    width: 360px;
    height: 76px;
    margin: 0;
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: white;
    background-color: var(--ok);
    border-width: 3px;
    border-color: var(--gold);
    border-radius: 12px;
    transition-property: background-color, scale, opacity;
    transition-duration: 0.15s;
}

.validate-button:hover { background-color: var(--ok-hover); scale: 1.03 1.03; }
.validate-button:active { background-color: var(--ok); scale: 0.98 0.98; }
.validate-button:disabled { opacity: 0.35; }
