:root {
    --bg: rgb(20, 17, 26);
    --panel: rgb(38, 32, 46);
    --panel-hover: rgb(54, 46, 66);
    --gold: rgb(224, 184, 64);
    --gold-dim: rgb(110, 92, 52);
    --text: rgb(240, 232, 215);
    --text-muted: rgb(160, 150, 140);
    --danger: rgb(220, 80, 70);
    --ok: rgb(48, 130, 60);
    --ok-hover: rgb(64, 160, 76);
}

.screen {
    flex-grow: 1;
    background-color: var(--bg);
    padding: 40px 64px 40px 64px;
}

/* ---------- En-tête ---------- */
.header { align-items: center; margin-bottom: 16px; }

.title {
    font-size: 58px;
    color: var(--gold);
    -unity-font-style: bold;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
}

.subtitle {
    font-size: 22px;
    color: var(--text-muted);
    margin-top: 6px;
}

/* ---------- Liste / slider ---------- */
.hero-list { flex-grow: 1; }

/* Centré quand tout tient à l'écran, défilement horizontal sinon */
#hero-list .unity-scroll-view__content-container {
    flex-grow: 1;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    padding: 36px 24px 24px 24px;
}

#hero-list .unity-base-slider__dragger {
    background-color: var(--gold-dim);
    border-radius: 6px;
}

#hero-list .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 6px;
}

/* ---------- Carte héros ---------- */
.hero-card {
    width: 300px;
    height: 540px;
    flex-shrink: 0;
    margin: 0 14px;
    padding: 14px;
    background-color: var(--panel);
    border-width: 3px;
    border-color: var(--gold-dim);
    border-radius: 14px;
    transition-property: translate, scale, background-color, border-color, opacity;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.hero-card:hover {
    background-color: var(--panel-hover);
    border-color: var(--gold);
    translate: 0 -6px;
}

.hero-card.hero-card--selected {
    background-color: var(--panel-hover);
    border-color: var(--gold);
    border-width: 4px;
    translate: 0 -10px;
    scale: 1.04 1.04;
}

.hero-card.hero-card--locked {
    opacity: 0.4;
}

.hero-card__header { align-items: center; }

.hero-card__name {
    font-size: 30px;
    color: var(--gold);
    -unity-font-style: bold;
}

.hero-card__class {
    font-size: 16px;
    color: var(--text-muted);
    letter-spacing: 2px;
}

.hero-card__image {
    height: 220px;
    margin: 10px 0 12px 0;
    background-color: rgb(24, 20, 30);
    border-width: 2px;
    border-color: var(--gold-dim);
    border-radius: 8px;
    -unity-background-scale-mode: scale-and-crop;
}

.hero-card__stats { flex-grow: 1; }

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 5px 2px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.stat-label { font-size: 18px; color: var(--text-muted); }
.stat-value { font-size: 18px; color: var(--text); -unity-font-style: bold; }

/* Pastille "CHOISI" */
.hero-card__badge {
    display: none;
    position: absolute;
    top: -18px;
    right: 14px;
    padding: 4px 14px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(30, 24, 10);
    background-color: var(--gold);
    border-radius: 12px;
}

.hero-card--selected .hero-card__badge { display: flex; }

/* ---------- Pied de page ---------- */
.footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
}

.counter {
    font-size: 28px;
    color: var(--text);
    transition-property: color;
    transition-duration: 0.2s;
}

.counter.counter--full { color: var(--gold); }
.counter.counter--warning { color: var(--danger); }

.validate-button {
    width: 320px;
    height: 76px;
    margin: 0;
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: white;
    background-color: var(--ok);
    border-width: 3px;
    border-color: var(--gold);
    border-radius: 12px;
    transition-property: background-color, scale, opacity;
    transition-duration: 0.15s;
}

.validate-button:hover { background-color: var(--ok-hover); scale: 1.03 1.03; }
.validate-button:active { background-color: var(--ok); scale: 0.98 0.98; }
.validate-button:disabled { opacity: 0.35; }