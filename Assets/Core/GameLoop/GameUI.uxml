<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:GroupBox style="flex-direction: row; align-self: flex-end; justify-content: center; align-items: auto; align-content: center; position: absolute; bottom: 0%; width: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
        <ui:Button text="Spell" name="Spell" style="aspect-ratio: 1; width: 6%; border-top-left-radius: 10%; border-top-right-radius: 10%; border-bottom-right-radius: 10%; border-bottom-left-radius: 10%; font-size: 12%; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; white-space: normal;"/>
        <ui:Button text="Search Treasure" name="SearchTreasure" style="aspect-ratio: 1; width: 6%; border-top-left-radius: 10%; border-top-right-radius: 10%; border-bottom-right-radius: 10%; border-bottom-left-radius: 10%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; text-overflow: clip; font-size: 9%; -unity-font-style: bold; justify-content: flex-start; flex-direction: column; align-content: flex-start; align-items: stretch; overflow: hidden; -unity-text-align: middle-center; flex-wrap: nowrap; white-space: normal;"/>
        <ui:Button text="Disarm Trap" name="Disarm" style="aspect-ratio: 1; width: 6%; border-top-left-radius: 10%; border-top-right-radius: 10%; border-bottom-right-radius: 10%; border-bottom-left-radius: 10%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; text-overflow: clip; font-size: 10%; -unity-font-style: bold; justify-content: flex-start; flex-direction: column; align-content: flex-start; align-items: stretch; overflow: hidden; -unity-text-align: middle-center; flex-wrap: nowrap; white-space: normal;"/>
    </ui:GroupBox>
</ui:UXML>
