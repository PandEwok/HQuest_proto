    <ui:GroupBox name="ModeButtons" class="ModeButtons" style="flex-direction: row; justify-content: center; align-content: center;">
        <ui:Button text="" name="AddButton" class="Button AddBtn" style="width: 5.8%; height: 10%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(0, 120, 255); border-right-color: rgb(0, 120, 255); border-top-color: rgb(0, 120, 255); border-bottom-color: rgb(0, 120, 255); display: flex; background-image: url(&quot;project://database/Assets/GameGrid/UI/AddIcon.png?fileID=2800000&amp;guid=62c28caa1d264484d9250c445a94d655&amp;type=3#AddIcon&quot;); background-color: rgb(194, 227, 255); aspect-ratio: 1;"/>
        <ui:Button text="" name="SelectButton" class="Button SelectBtn" style="height: 10px; width: 5.8%; padding-top: 1px; padding-right: 2px; padding-bottom: 1px; padding-left: 2px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(0, 120, 255); border-right-color: rgb(0, 120, 255); border-top-color: rgb(0, 120, 255); border-bottom-color: rgb(0, 120, 255); background-image: url(&quot;project://database/Assets/GameGrid/UI/SelectIcon.png?fileID=2800000&amp;guid=062b691df40490340b4beddeefad801c&amp;type=3#SelectIcon&quot;); background-color: rgb(194, 227, 255); aspect-ratio: 1;"/>
