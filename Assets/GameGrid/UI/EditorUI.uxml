    <ui:ScrollView style="display: flex; align-self: flex-end; position: absolute; height: 100%; width: 13%; background-color: rgba(0, 0, 0, 0.627); align-content: auto; justify-content: flex-start; align-items: center;">
        <ui:Toggle label="Toggle" style="justify-content: flex-start; align-self: center; align-content: auto; left: auto; right: auto; flex-direction: column; width: 90%; height: 100%; align-items: flex-start; flex-wrap: nowrap; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
